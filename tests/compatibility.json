  "explores": {
    "events": {
      "always_filter": {
        "filters__all": [
          [
            {
              "events.event_date": "7 days"
            }
          ]
        ]
      },
      "joins": [
        {
          "relationship": "many_to_one",
          "sql_on": "${events.player_key} = ${user_facts.player_key}",
          "name": "user_facts"
        },
        {
          "relationship": "many_to_one",
          "sql_on": "${events.unique_session_id} = ${session_facts.unique_session_id}",
          "name": "session_facts"
        }
      ],
      "name": "events"
    },
    "session_facts": {
      "joins": [
        {
          "relationship": "many_to_one",
          "sql_on": "${session_facts.player_key} = ${user_facts.player_key}",
          "name": "user_facts"
        }
      ],
      "name": "session_facts"
    },
    "user_facts": {
      "name": "user_facts"
    },
    "funnel_explorer": {
      "joins": [
        {
          "relationship": "many_to_one",
          "sql_on": "${funnel_explorer.player_key} = ${user_facts.player_key}",
          "name": "user_facts"
        },
        {
          "relationship": "many_to_one",
          "sql_on": "${funnel_explorer.unique_session_id} = ${session_facts.unique_session_id}",
          "name": "session_facts"
        }
      ],
      "name": "funnel_explorer"
    },
    "level_balancing": {
      "joins": [
        {
          "relationship": "many_to_one",
          "sql_on": "${level_balancing.player_key} = ${user_facts.player_key}",
          "name": "user_facts"
        }
      ],
      "name": "level_balancing"
    },
    "top_countries": {
      "name": "top_countries"
    },
    "lifetime_user_facts": {
      "name": "lifetime_user_facts"
    }
  },
  "model_settings": {
    "connection": "gamepulse_bigquery",
    "label": "GamePulse Gaming Analytics",
    "includes": [
      "/views/*.view.lkml",
      "/derived_tables/*.view.lkml",
      "/lookml_dashboards/*.dashboard.lookml"
    ],
    "datagroups": [
      {
        "sql_trigger": "SELECT CAST(MAX(published_at) AS STRING) FROM `gamepulse.pipeline_state` WHERE status = 'complete'",
        "max_cache_age": "24 hours",
        "name": "events_raw"
      }
    ],
    "persist_with": "events_raw"
  }
}
